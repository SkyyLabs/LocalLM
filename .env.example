# Default: keep sensitive documents on your machine.
LLM_PROVIDER=local

# Local Ollama settings.
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5

# Cloud settings are only used when LLM_PROVIDER=cloud.
# Any OpenAI-compatible endpoint can be used here.
CLOUD_LLM_BASE_URL=https://api.openai.com/v1
CLOUD_LLM_MODEL=gpt-4o-mini
CLOUD_LLM_API_KEY=

# Prompt and privacy settings.
SYSTEM_PROMPT_PATH=prompts/system_prompt.md
PRIVATE_DATA_DIR=data/private
INDEX_DIR=data/index

# RAG/indexing settings. EMBEDDING_PROVIDER is intentionally local-only today.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=nomic-embed-text
VECTOR_STORE=chroma

# Set to true only if you want non-interactive cloud processing of private docs.
ALLOW_CLOUD_PRIVATE_DOCS=false

# Optional no-argument workflow. Running `python main.py` reads these values
# and config/workflow.json when present. Environment values override the file.
APP_CONFIG_PATH=config/workflow.json
# APP_TASK=chat
# APP_FILE=data/private/example.pdf
# APP_QUESTION=Summarize this document
# APP_SCHEMA=schemas/example_schema.json
# APP_PATH=data/private
# APP_TAGS=financial,taxes
# APP_METADATA=owner=me,year=2026
# APP_METADATA_FILE=schemas/metadata.example.json
# APP_FILTERS=document_type=tax,year=2025
# APP_LIMIT=5
# APP_CHUNK_SIZE=1200
# APP_OVERLAP=150
# APP_YES=false
